<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_padding_h"
        android:paddingTop="@dimen/page_padding_v"
        android:paddingEnd="@dimen/page_padding_h"
        android:paddingBottom="@dimen/page_padding_v">

        <!-- Status: the one thing this screen is for. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/now_label"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/nowTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:accessibilityLiveRegion="polite"
            android:fontFamily="sans-serif-medium"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="28sp" />

        <TextView
            android:id="@+id/nowDetail"
            style="@style/Help"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/nowDiscord"
            style="@style/Help"
            android:textSize="15sp" />

        <Button
            android:id="@+id/renameGame"
            style="@style/Row"
            android:layout_width="wrap_content"
            android:text="@string/rename_game"
            android:visibility="gone" />

        <TextView
            android:id="@+id/problem"
            style="@style/Help"
            android:layout_marginTop="12dp"
            android:accessibilityLiveRegion="polite"
            android:textColor="?android:attr/colorError"
            android:textSize="15sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/kizzyWarning"
            style="@style/Help"
            android:layout_marginTop="12dp"
            android:accessibilityLiveRegion="polite"
            android:textColor="?android:attr/colorError"
            android:textSize="15sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/clearStatus"
            style="@style/Row"
            android:layout_width="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/clear_status" />

        <Switch
            android:id="@+id/enableSwitch"
            style="@style/Row"
            android:layout_marginTop="16dp"
            android:text="@string/enable_switch" />

        <TextView
            android:id="@+id/rootStatus"
            style="@style/Help" />

        <Button
            android:id="@+id/rootRetry"
            style="@style/Row"
            android:layout_width="wrap_content"
            android:text="@string/root_retry"
            android:visibility="gone" />

        <!-- Discord account -->
        <TextView
            style="@style/Section"
            android:text="@string/section_account" />

        <TextView
            android:id="@+id/accountStatus"
            style="@style/Help"
            android:textSize="15sp" />

        <LinearLayout
            android:id="@+id/accountButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/signInWeb"
                    style="@style/RowButton"
                    android:layout_marginEnd="8dp"
                    android:text="@string/sign_in_web" />

                <Button
                    android:id="@+id/signInKizzy"
                    style="@style/RowButton"
                    android:text="@string/sign_in_kizzy" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/signInPaste"
                    style="@style/RowButton"
                    android:layout_marginEnd="8dp"
                    android:text="@string/sign_in_paste" />

                <Button
                    android:id="@+id/signOut"
                    style="@style/RowButton"
                    android:text="@string/sign_out" />
            </LinearLayout>
        </LinearLayout>

        <!-- Backend -->
        <TextView
            style="@style/Section"
            android:text="@string/section_backend" />

        <RadioGroup
            android:id="@+id/backendGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/backendBuiltin"
                style="@style/Row"
                android:text="@string/backend_builtin" />

            <RadioButton
                android:id="@+id/backendKizzy"
                style="@style/Row"
                android:text="@string/backend_kizzy" />
        </RadioGroup>

        <TextView
            android:id="@+id/backendNote"
            style="@style/Help" />

        <!-- Detection -->
        <TextView
            style="@style/Section"
            android:text="@string/section_watch" />

        <Switch
            android:id="@+id/watchGameNative"
            style="@style/Row"
            android:text="@string/watch_gamenative" />

        <Switch
            android:id="@+id/watchEden"
            style="@style/Row"
            android:text="@string/watch_eden" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/row_gap"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/pollLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:labelFor="@id/pollSpinner"
                android:text="@string/poll_label"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="16sp" />

            <Spinner
                android:id="@+id/pollSpinner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp" />
        </LinearLayout>

        <!-- Look -->
        <TextView
            style="@style/Section"
            android:text="@string/section_look" />

        <RadioGroup
            android:id="@+id/artGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/artCover"
                style="@style/Row"
                android:text="@string/art_cover" />

            <RadioButton
                android:id="@+id/artHeader"
                style="@style/Row"
                android:text="@string/art_header" />
        </RadioGroup>

        <Switch
            android:id="@+id/showLauncher"
            style="@style/Row"
            android:text="@string/show_launcher" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/row_gap"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:labelFor="@id/statusSpinner"
                android:text="@string/status_label"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="16sp" />

            <Spinner
                android:id="@+id/statusSpinner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp" />
        </LinearLayout>

        <!-- Saved names -->
        <TextView
            style="@style/Section"
            android:text="@string/section_names" />

        <LinearLayout
            android:id="@+id/namesList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- Troubleshooting -->
        <TextView
            style="@style/Section"
            android:text="@string/section_debug" />

        <TextView
            style="@style/Help"
            android:text="@string/debug_hint" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/debugRun"
                style="@style/RowButton"
                android:layout_marginEnd="8dp"
                android:text="@string/debug_run" />

            <Button
                android:id="@+id/debugCopy"
                style="@style/RowButton"
                android:enabled="false"
                android:text="@string/debug_copy" />
        </LinearLayout>

        <TextView
            android:id="@+id/debugOutput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace"
            android:textIsSelectable="true"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- Advanced -->
        <TextView
            style="@style/Section"
            android:text="@string/section_advanced" />

        <TextView
            android:id="@+id/appIdLabel"
            style="@style/Help"
            android:labelFor="@id/appId"
            android:text="@string/app_id_label"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/appId"
            style="@style/Row"
            android:layout_marginTop="0dp"
            android:importantForAutofill="no"
            android:inputType="number"
            android:maxLength="20" />

        <TextView
            style="@style/Help"
            android:text="@string/app_id_help" />

        <TextView
            style="@style/Help"
            android:layout_marginTop="16dp"
            android:labelFor="@id/extraGameNative"
            android:text="@string/extra_gn_label"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/extraGameNative"
            style="@style/Row"
            android:layout_marginTop="0dp"
            android:hint="@string/extra_hint"
            android:importantForAutofill="no"
            android:inputType="text|textNoSuggestions" />

        <TextView
            style="@style/Help"
            android:layout_marginTop="16dp"
            android:labelFor="@id/extraEden"
            android:text="@string/extra_eden_label"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/extraEden"
            style="@style/Row"
            android:layout_marginTop="0dp"
            android:hint="@string/extra_hint"
            android:importantForAutofill="no"
            android:inputType="text|textNoSuggestions" />

        <Button
            android:id="@+id/advancedSave"
            style="@style/Row"
            android:layout_width="wrap_content"
            android:text="@string/advanced_save" />
    </LinearLayout>
</ScrollView>
